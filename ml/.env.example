# Copy to ml/.env for local runs. On Kaggle these values come from
# Add-ons -> Secrets instead (see ml/notebooks/kaggle/00_kaggle_setup.ipynb).

# --- Local data / artifacts (ignored on Kaggle) ---
# Both may stay empty: paths resolve to /kaggle/input + /kaggle/working on
# Kaggle and to ml/data + ml/artifacts locally.
ML_DATA_ROOT=
ML_ARTIFACT_ROOT=

# --- Supabase Storage (artifact + model upload) ---
# Training uses the S3-compatible endpoint, so it needs the S3 access key pair
# (Supabase dashboard -> Storage -> S3 access keys), not the service-role key.
SUPABASE_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_BUCKET_MODELS=agri-models

# --- Dataset download (only if not using a Kaggle dataset) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
