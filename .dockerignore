docs/
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo
ml/data/
ml/notebooks/
ml/artifacts/runs/
ml/.env
backend/tests/
backend/alembic.ini
backend/agrisense_local.db
backend/data/
