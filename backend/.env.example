# Copy to backend/.env and fill in. Never commit real values (NFR-S-002).

# --- Application ---
APP_NAME=AgriSense AI API
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- HTTP / CORS (comma-separated allow-list) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10
RATE_LIMIT_PREDICT=20/minute

# --- Disease pipeline ---
CONFIDENCE_THRESHOLD=0.60

# --- Weather ---
WEATHER_PRIMARY=open-meteo
WEATHER_FALLBACK=nasa-power
WEATHER_CACHE_TTL_MIN=180

# --- Model registry ---
# Leave empty until production models exist. Example:
# MODEL_REGISTRY_URI=supabase://agri-models/models/production.json
MODEL_REGISTRY_URI=
MODEL_CACHE_DIR=/tmp/models
# Set to true once models are promoted: makes /health/ready return 503 when missing.
REQUIRE_MODELS=false

# --- Database (Supabase PostgreSQL, Phase 5) ---
# Use the connection pooler URL (port 6543) when deploying to IPv4-only hosts.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only needed for the stretch auth goal (DEV_PLAN 5.14), when the
# backend verifies Supabase-issued JWTs. Leave empty while auth is out of scope.
# Two ways to verify a token, depending on how the project signs them:
#   1. Asymmetric keys (default for new projects) -> fetch the public keys from
#      https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json and store
#      no secret here. Preferred.
#   2. Legacy shared secret (HS256) -> Project Settings -> API Keys -> JWT Keys
#      (older projects: API -> JWT Settings) -> "JWT Secret".
# This is NOT the sb_secret_... service-role key; that is an API key, not a
# signing key.
SUPABASE_JWT_SECRET=
JWT_SECRET_KEY=agrisense-production-secure-jwt-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Object storage (Supabase Storage, Phase 5) ---
# Backend uses the REST API with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# Training (Kaggle) uses the S3-compatible endpoint, which needs its own keys
# from Supabase dashboard -> Storage -> S3 access keys.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Must match the project region or S3 signatures are rejected.
SUPABASE_S3_REGION=us-east-1
SUPABASE_BUCKET_UPLOADS=agri-uploads
SUPABASE_BUCKET_OVERLAYS=agri-overlays
SUPABASE_BUCKET_MODELS=agri-models
